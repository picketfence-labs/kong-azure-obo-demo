# docker compose用の環境変数。コピーして .env を作成する（.envはコミット対象外）。
#   cp .env.example .env

# Konnect Control PlaneのData Plane Nodes画面に表示されるendpointのhost部分。
# schemeは付けず、portも指定しない（Composeが:443を付与する）。
KONNECT_CONTROL_PLANE_HOST=example.cp.konghq.com
KONNECT_TELEMETRY_HOST=example.tp.konghq.com

# Konnectへ登録済みのData Plane mTLS certificate/keyのローカルパス。
# 実ファイルはgitignore済みのsecrets/配下へ保存する。
KONNECT_CLUSTER_CERT_PATH=./secrets/konnect/tls.crt
KONNECT_CLUSTER_CERT_KEY_PATH=./secrets/konnect/tls.key
